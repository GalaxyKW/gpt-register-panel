PANEL_HOST=127.0.0.1
PANEL_PORT=4170
# systemd selects this file through PANEL_ENV_FILE outside the file itself.
# Keep production secrets in /etc/gpt-register-panel/panel.env with mode 0600.
# Every boolean setting in this file accepts only the literal value 0 or 1.
# Authentication defaults to enabled even when PANEL_REQUIRE_AUTH is omitted.
GPT_REGISTER_ROOT=/mnt/nvme/gpt_register
# Bounded source reads (defaults shown; larger values are still hard-capped).
GPT_REGISTER_TOKEN_MAX_BYTES=4194304
GPT_REGISTER_TOKEN_MAX_FILES=10000
# Counts every directory entry, including ignored non-JSON files.
GPT_REGISTER_TOKEN_MAX_DIRECTORY_ENTRIES=20000
GPT_REGISTER_TOKEN_TOTAL_MAX_BYTES=268435456
GPT_REGISTER_USERNAME_MAX_BYTES=33554432
GPT_REGISTER_USERNAME_MAX_RECORDS=10000
# Runtime state is intentionally outside Git. Use /tmp only for disposable development runs.
PANEL_DB_PATH=/mnt/nvme/item/gpt-register-panel/runtime/panel.sqlite3
PANEL_DB_MAX_BYTES=134217728
PANEL_BACKUP_DIR=/mnt/nvme/item/gpt-register-panel/runtime/backups
PANEL_BACKUP_RETENTION_DAYS=30
PANEL_BACKUP_MAX_FILES=100
PANEL_BACKUP_MAX_TOTAL_BYTES=536870912
# Structured JSON Lines audit log. Keep this outside Git and readable only by the service user.
PANEL_LOG_PATH=/mnt/nvme/item/gpt-register-panel/runtime/panel.log
PANEL_LOG_LEVEL=info
PANEL_LOG_MAX_BYTES=10485760
PANEL_LOG_ROTATIONS=5
PANEL_LOG_CONSOLE=1
# API reads and writes require this token when PANEL_REQUIRE_AUTH=1. Use a
# random 16-4096 character printable ASCII value without spaces; never commit it.
PANEL_ADMIN_TOKEN=
PANEL_REQUIRE_AUTH=1
PANEL_WRITE_ENABLED=0
# Keep insecure bypasses disabled outside an isolated local development run.
PANEL_ALLOW_INSECURE_WRITE=0
# Non-loopback binding always requires an admin token. This additional switch
# only acknowledges that the panel itself serves plaintext HTTP; prefer an SSH
# tunnel or a same-host HTTPS reverse proxy while leaving PANEL_HOST loopback.
PANEL_ALLOW_INSECURE_REMOTE=0
PANEL_AUTH_MAX_FAILURES=10
PANEL_AUTH_WINDOW_MS=60000
PANEL_AUTH_BLOCK_MS=60000
# Bound unauthenticated slow-header/body connections before route handling.
PANEL_HTTP_REQUEST_TIMEOUT_MS=30000
PANEL_HTTP_HEADERS_TIMEOUT_MS=15000
PANEL_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
PANEL_HTTP_MAX_HEADERS=100
PANEL_HTTP_MAX_REQUESTS_PER_SOCKET=100
# Graceful shutdown waits this many milliseconds for active jobs (maximum 12000).
# Phase3 启用时不得低于 6000，建议保持 10000 以留出终态落盘时间。
PANEL_SHUTDOWN_TIMEOUT_MS=10000
PANEL_ALLOW_UNBACKED_WRITES=0
PANEL_DB_LOCK_TIMEOUT_MS=30000
# Cross-process task lock. Leave the path empty to derive it from PANEL_DB_PATH.
PANEL_CONTROL_LOCK_PATH=
PANEL_CONTROL_LOCK_TIMEOUT_MS=21600000
PANEL_CONTROL_LOCK_POLL_MS=50
PANEL_MAX_JOBS=5000
# Accepted mutation receipts survive browser response loss and process restart.
# TTL is clamped to 1-30 days; capacity is a hard fail-closed limit (max 10000).
PANEL_IDEMPOTENCY_TTL_MS=604800000
PANEL_IDEMPOTENCY_MAX_RECEIPTS=2000
PANEL_MAX_AUDIT_EVENTS=20000
PANEL_MAX_SNAPSHOTS=500
# Phase 3 starts the fixed gpt_register program only when explicitly enabled.
PANEL_PHASE3_ENABLED=0
PANEL_PHASE3_TIMEOUT_MS=1800000
PANEL_PHASE3_MAX_OUTPUT_BYTES=262144
# Hard-capped at 4000; a further one-second verification window keeps process
# cleanup below the server's default ten-second shutdown drain.
PANEL_PHASE3_KILL_GRACE_MS=4000
PANEL_PHASE3_MAX_ACTIVE_JOBS=100
GPT_REGISTER_NODE_PATH=/usr/bin/node
SUB2API_BASE_URL=http://127.0.0.1:8080
# Prefer a dedicated Sub2API admin API key for the panel worker.
SUB2API_ADMIN_API_KEY=
# Alternatively provide a short-lived admin JWT for local testing.
SUB2API_JWT=
SUB2API_TIMEOUT_MS=15000
SUB2API_TEST_TIMEOUT_MS=120000
SUB2API_MAX_RESPONSE_BYTES=4194304
# Non-loopback plaintext HTTP is rejected unless this explicit dangerous override is set.
SUB2API_ALLOW_INSECURE_HTTP=0
# A whole account-test batch stops after this deadline; individual requests use the remaining time.
PANEL_ACCOUNT_TEST_JOB_TIMEOUT_MS=1800000
# Expired files are moved here instead of permanently deleted.
PANEL_TOKEN_QUARANTINE_DIR=
# Optional comma-separated Sub2API group IDs. Leave empty to use its default binding.
SUB2API_GROUP_IDS=
SUB2API_GROUP_NAME=share
SUB2API_CONFIRM_MIXED_CHANNEL_RISK=0
