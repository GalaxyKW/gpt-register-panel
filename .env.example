PANEL_HOST=127.0.0.1
PANEL_PORT=4170
GPT_REGISTER_ROOT=/mnt/nvme/gpt_register
# Runtime state is intentionally outside Git. Use /tmp only for disposable development runs.
PANEL_DB_PATH=/mnt/nvme/item/gpt-register-panel/runtime/panel.sqlite3
PANEL_BACKUP_DIR=/mnt/nvme/item/gpt-register-panel/runtime/backups
PANEL_BACKUP_RETENTION_DAYS=30
# Keep read-only by default. Write endpoints additionally require this token.
PANEL_ADMIN_TOKEN=
PANEL_REQUIRE_AUTH=0
PANEL_WRITE_ENABLED=0
PANEL_ALLOW_INSECURE_WRITE=0
PANEL_ALLOW_UNBACKED_WRITES=0
# Phase 3 starts the fixed gpt_register program only when explicitly enabled.
PANEL_PHASE3_ENABLED=0
PANEL_PHASE3_TIMEOUT_MS=1800000
GPT_REGISTER_NODE_PATH=/usr/bin/node
SUB2API_BASE_URL=http://127.0.0.1:8080
# Prefer a dedicated Sub2API admin API key for the panel worker.
SUB2API_ADMIN_API_KEY=
# Alternatively provide a short-lived admin JWT for local testing.
SUB2API_JWT=
SUB2API_TIMEOUT_MS=15000
# Optional comma-separated Sub2API group IDs. Leave empty to use its default binding.
SUB2API_GROUP_IDS=
SUB2API_GROUP_NAME=share
SUB2API_CONFIRM_MIXED_CHANNEL_RISK=0
